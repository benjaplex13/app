# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# SUPABASE (PostgreSQL Gestionado en la Nube)
# ============================================================================
# SUPABASE_URL: URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co).
# Se encuentra en: Project Settings -> API -> Project URL.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Clave secreta de servicio (Service Role Key) para Node.js server-side.
# Permite realizar operaciones seguras en la base de datos sin exponerla al navegador.
# Se encuentra en: Project Settings -> API -> Project API Keys -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# BREVO (Envío de Correos Transaccionales y OTP con Single Sender - Sin dominio)
# ============================================================================
# BREVO_API_KEY: Clave de API v3 de Brevo (https://brevo.com) (formato: xkeysib-....).
# Se obtiene en: https://app.brevo.com -> Menú superior derecho (tu perfil) -> SMTP & API -> Claves de API -> Generar una nueva clave API.
BREVO_API_KEY=

# BREVO_FROM_EMAIL: Correo remitente verificado como remitente individual en Brevo (ej: benchomateosa@gmail.com).
# NO requiere comprar dominio propio. Se añade en: Menú superior derecho -> Remitentes e IP -> Añadir un remitente.
BREVO_FROM_EMAIL="benchomateosa@gmail.com"

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# JWT_SECRET: Secreto criptográfico para firmar los tokens de sesión de los usuarios.
JWT_SECRET=

# ============================================================================
# FLOW.CL (Pasarela de Pago y Suscripciones para Chile)
# ============================================================================
# FLOW_API_KEY: API Key pública/comercio de tu cuenta en Flow.cl (o Sandbox).
# Se obtiene en: https://www.flow.cl -> Mis Datos -> Credenciales / API.
FLOW_API_KEY=

# FLOW_SECRET_KEY: Llave Secreta para firmar peticiones y validar webhooks mediante HMAC-SHA256.
# NUNCA compartir ni exponer en el frontend.
FLOW_SECRET_KEY=

# FLOW_SANDBOX: 'true' para usar el entorno de pruebas https://sandbox.flow.cl/api, 'false' para producción.
FLOW_SANDBOX=true

# ============================================================================
# DEMO MODE (Opcional - Pruebas internas)
# ============================================================================
# DEMO_OTP_CODE: Código OTP maestro opcional (ej: 000000) para pruebas internas y demos rápidas.
# Si no está configurada, el backend SOLO aceptará el código real enviado por correo.
DEMO_OTP_CODE=
