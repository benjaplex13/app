# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# SUPABASE (PostgreSQL Gestionado en la Nube)
# ============================================================================
# SUPABASE_URL: URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co).
# Se encuentra en: Project Settings -> API -> Project URL.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Clave secreta de servicio (Service Role Key) para Node.js server-side.
# Permite realizar operaciones seguras en la base de datos sin exponerla al navegador.
# Se encuentra en: Project Settings -> API -> Project API Keys -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# BREVO (Envío de Correos Transaccionales y OTP con Single Sender - Sin dominio)
# ============================================================================
# BREVO_API_KEY: Clave de API v3 de Brevo (https://brevo.com) (formato: xkeysib-....).
# Se obtiene en: https://app.brevo.com -> Menú superior derecho (tu perfil) -> SMTP & API -> Claves de API -> Generar una nueva clave API.
BREVO_API_KEY=

# BREVO_FROM_EMAIL: Correo remitente verificado como remitente individual en Brevo (ej: benchomateosa@gmail.com).
# NO requiere comprar dominio propio. Se añade en: Menú superior derecho -> Remitentes e IP -> Añadir un remitente.
BREVO_FROM_EMAIL="benchomateosa@gmail.com"

# ============================================================================
# ENVIRONMENT & SECURITY FLAGS (OWASP Hardening)
# ============================================================================
# NODE_ENV: 'production' en Vercel/Cloud Run. Desactiva inmediatamente cualquier bypass demo u OTP maestro.
NODE_ENV=production

# OWNER_EMAIL: Correo verificado del propietario/desarrollador con plan 'developer' ilimitado.
OWNER_EMAIL="benchomateosa@gmail.com"

# ADMIN_DEBUG_KEY: Clave secreta opcional (mínimo 16 caracteres) para acceder a los diagnósticos detallados en /api/health en producción.
# Si no se envía en el header 'x-admin-debug-key' o query 'debugKey', /api/health solo devuelve {"status":"ok"}.
ADMIN_DEBUG_KEY=

# ENABLE_DEMO_OTP: 'true' solo en local si se desea habilitar DEMO_OTP_CODE en registro. 'false' en producción.
ENABLE_DEMO_OTP=false

# DEMO_CHECKOUT_ENABLED: 'true' SOLO si el propietario desea habilitar activación simulada sin pasar por Flow.
# Si no está configurada o es 'false', el backend rechaza cualquier bypass con 403 y exige pago real en Flow.
DEMO_CHECKOUT_ENABLED=false

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# JWT_SECRET: Secreto criptográfico de alta entropía (mínimo 32 caracteres) para firmar tokens de sesión.
# En producción, si esta variable falta o es menor a 32 caracteres, el backend bloqueará el arranque por seguridad.
JWT_SECRET=

# ============================================================================
# FLOW.CL (Pasarela de Pago y Suscripciones para Chile)
# ============================================================================
# FLOW_API_KEY: API Key pública/comercio de tu cuenta en Flow.cl (o Sandbox).
# Se obtiene en: https://www.flow.cl -> Mis Datos -> Credenciales / API.
FLOW_API_KEY=

# FLOW_SECRET_KEY: Llave Secreta para firmar peticiones y validar webhooks mediante HMAC-SHA256.
# NUNCA compartir ni exponer en el frontend.
FLOW_SECRET_KEY=

# FLOW_SANDBOX: 'true' para usar el entorno de pruebas https://sandbox.flow.cl/api, 'false' para producción.
FLOW_SANDBOX=true

# ============================================================================
# DEMO MODE (Solo para pruebas locales)
# ============================================================================
# DEMO_OTP_CODE: Código OTP maestro opcional (ej: 000000) solo si ENABLE_DEMO_OTP=true y NODE_ENV!=production.
DEMO_OTP_CODE=
