# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# SUPABASE (PostgreSQL Gestionado en la Nube)
# ============================================================================
# SUPABASE_URL: URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co).
# Se encuentra en: Project Settings -> API -> Project URL.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Clave secreta de servicio (Service Role Key) para Node.js server-side.
# Permite realizar operaciones seguras en la base de datos sin exponerla al navegador.
# Se encuentra en: Project Settings -> API -> Project API Keys -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# RESEND (Envío de Correos Transaccionales y OTP)
# ============================================================================
# RESEND_API_KEY: Clave de API de Resend (https://resend.com) para enviar correos reales (OTP y recuperación).
# Se obtiene en: https://resend.com -> API Keys -> Create API Key (formato: re_...).
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Remitente de los correos (ej: "Rumbio <onboarding@resend.dev>" o tu dominio propio verificado).
RESEND_FROM_EMAIL="Rumbio <onboarding@resend.dev>"

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# JWT_SECRET: Secreto criptográfico para firmar los tokens de sesión de los usuarios.
JWT_SECRET=

# ============================================================================
# DEMO MODE (Opcional - Pruebas internas)
# ============================================================================
# DEMO_OTP_CODE: Código OTP maestro opcional (ej: 000000) para pruebas internas y demos rápidas.
# Si no está configurada, el backend SOLO aceptará el código real enviado por correo.
DEMO_OTP_CODE=
